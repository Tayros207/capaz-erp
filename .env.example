# Copia este archivo a .env (no se sube al repositorio). Todas las variables se validan al arrancar.
# Base local (docker compose up -d db, puerto 5450). El superusuario `capaz` SOLO lo usa `pnpm db:preparar`.
DATABASE_URL_ADMIN=postgres://capaz:capaz_dev@localhost:5450/postgres
# Cuatro roles sin superusuario (ADR-011); `pnpm db:preparar` los crea con la contraseña de cada URL
# (alfanumérica simple, 12 caracteres o más). El servidor solo recibe APP, AUTH y SISTEMA.
DATABASE_URL_OWNER=postgres://capaz_owner:dev_owner_123456@localhost:5450/capaz
DATABASE_URL_AUTH=postgres://capaz_auth:dev_auth_1234567@localhost:5450/capaz
DATABASE_URL_APP=postgres://capaz_app:dev_app_12345678@localhost:5450/capaz
DATABASE_URL_SISTEMA=postgres://capaz_sistema:dev_sistema_1234@localhost:5450/capaz
# Secretos de desarrollo (32 caracteres o más). En producción: valores aleatorios propios.
BETTER_AUTH_SECRET=dev-secret-solo-para-local-0123456789abcdef
CONFIRMACION_SECRET=dev-confirmacion-solo-local-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3001
ORIGENES_PERMITIDOS=http://localhost:5173
# plataforma: solo el operador crea empresas. abierta: cualquiera puede crear la suya.
ALTA_DE_EMPRESAS=abierta
# Intentos de inicio de sesión o registro por minuto y por dirección.
INTENTOS_DE_ACCESO=5
PORT=3001
# Relevo: barrido periódico de eventos y tareas. Las pruebas lo apagan.
RELEVO_ACTIVO=true
RELEVO_BARRIDO_SEGUNDOS=60
# Clave de cifrado de credenciales de conexiones: 32 bytes en base64 (openssl rand -base64 32).
# Opcional hasta la fase 11a; entonces será obligatoria en producción.
# Clave maestra de las credenciales de conexiones: 32 bytes en base64 (openssl rand -base64 32). Obligatoria en producción.
# CONEXIONES_CLAVE=
CONEXIONES_CLAVE_VERSION=1
# Solo para pruebas con servidor simulado; en producción siempre false.
PERMITIR_DESTINOS_LOCALES=false
# Asistente: apagado (por defecto) | simulado (solo pruebas) | openrouter (llama al modelo de verdad).
# La llave va solo aquí o en las variables de Vercel, nunca en el código. Sin llave, deja el proveedor apagado.
AGENTE_PROVEEDOR=apagado
# OPENROUTER_API_KEY=
# AGENTE_MODELO=deepseek/deepseek-v4.1-flash-1017
# AGENTE_RAZONAMIENTO=none
# Tope mensual por empresa, en dólares (provisional hasta que se fije uno).
# AGENTE_TOPE_MENSUAL_USD=5
# AGENTE_RETENCION_DIAS=90
# AGENTE_MAX_RONDAS=12
# Freno global: «apagada» deja todos los cambios del asistente como borrador.
# AGENTE_ESCRITURA=activa
# Internet del asistente (buscar y leer páginas): «apagada» lo quita en todas las empresas.
# AGENTE_INTERNET=activa
# AGENTE_WEB_MODELO=anthropic/claude-sonnet-5.5
# Modelo que transcribe el dictado por audio (Firefox y otros navegadores sin reconocimiento de voz). Debe aceptar audio y tener
# proveedores sin retención (ZDR). Solo con AGENTE_PROVEEDOR=openrouter; el audio sale a ese proveedor y cuenta para el mismo tope mensual.
# AGENTE_VOZ_MODELO=google/gemini-3.5-flash-lite
# Modelo que entiende el dictado (captura) y rellena la propuesta. Solo con AGENTE_PROVEEDOR=openrouter; cuenta para el mismo tope mensual.
# CAPTURA_MODELO=anthropic/claude-sonnet-5.5
