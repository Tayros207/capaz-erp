{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "buildCommand": "pnpm --filter @capaz/shared build && pnpm --filter api build && rm -rf ../../.deploy-api && pnpm --filter api --prod deploy --legacy --config.node-linker=hoisted ../../.deploy-api && rm -rf ../../.deploy-api/node_modules/.bin && cp -r ../../.deploy-api/node_modules dist/node_modules && echo '{\"type\":\"module\"}' > dist/package.json"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm --filter @capaz/shared build && pnpm --filter web build",
      "headers": [
        {
          "source": "/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/presentacion/index.html"
        },
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
